# Copy this file to .env.local and fill in the 3 values.
# Everything else (list IDs, form ID, property ID, prices) lives in
# lib/config.ts — safe to commit.

# 1. Klaviyo private API key (read-only scopes are enough)
KLAVIYO_PRIVATE_KEY=

# 2. Typeform personal access token
TYPEFORM_TOKEN=

# 3. GA4 service account credentials — pick ONE of these:
#
# Option A (LOCAL DEV): point at the downloaded JSON key file
#   GA4_SERVICE_ACCOUNT_FILE=./service-account.json
#
# Option B (VERCEL):    base64-encode the JSON and paste it here
#                       (on Mac/Linux: `base64 -i service-account.json -o /tmp/sa.b64 && cat /tmp/sa.b64`)
#                       (on Windows PS: `[Convert]::ToBase64String([IO.File]::ReadAllBytes("sa.json"))`)
#   GA4_SERVICE_ACCOUNT_JSON_B64=
#
# Option C: paste raw JSON content as single-line string
#   GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GA4_SERVICE_ACCOUNT_FILE=
GA4_SERVICE_ACCOUNT_JSON_B64=
GA4_SERVICE_ACCOUNT_JSON=
